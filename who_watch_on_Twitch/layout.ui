<?xml version='1.0' encoding='utf-8'?>
<interface version="1.4" author="PygubuDesigner 0.39.3">
  <project>
    <settings />
    <customwidgets />
  </project>
  <object class="tk.Tk" id="main_tk" named="True">
    <property name="background">#944CFF</property>
    <property name="height">500</property>
    <property name="width">900</property>
    <containerlayout manager="grid">
      <property name="anchor">s</property>
      <property name="propagate">false</property>
      <property type="row" id="1" name="pad">200</property>
    </containerlayout>
    <child>
      <object class="ttk.Button" id="btn_1" named="True">
        <property name="cursor">tcross</property>
        <property name="text" translatable="yes">profile_1</property>
        <property name="width">20</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="row">1</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Button" id="btn_2" named="True">
        <property name="text" translatable="yes">profile_2</property>
        <property name="width">20</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="pady">40</property>
          <property name="row">4</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Button" id="btn_3" named="True">
        <property name="text" translatable="yes">profile_3</property>
        <property name="width">20</property>
        <layout manager="grid">
          <property name="column">3</property>
          <property name="row">1</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Button" id="btn_4" named="True">
        <property name="text" translatable="yes">profile_4</property>
        <property name="width">20</property>
        <layout manager="grid">
          <property name="column">3</property>
          <property name="pady">40</property>
          <property name="row">4</property>
          <property name="sticky">s</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Text" id="text1">
        <property name="background">#944CFF</property>
        <property name="borderwidth">0</property>
        <property name="cursor">arrow</property>
        <property name="font">{Courier New} 24 {}</property>
        <property name="foreground">#ffffff</property>
        <property name="height">0</property>
        <property name="insertunfocussed">hollow</property>
        <property name="insertwidth">0</property>
        <property name="relief">raised</property>
        <property name="state">disabled</property>
        <property name="tabstyle">wordprocessor</property>
        <property name="text" translatable="yes">Chi vuoi guardare oggi?</property>
        <property name="width">23</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="columnspan">4</property>
          <property name="pady">0</property>
          <property name="row">0</property>
          <property name="rowspan">1</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
